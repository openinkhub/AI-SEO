# Copy to .env for local dev. In production (Hostinger), set these as
# Environment Variables in the Node.js App settings screen instead of a file.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# WP <-> Engine integration (see claude/hybrid-architecture-migration-plan.md,
# "Integration between WP and Engine"). WP_ENGINE_API_KEY is the shared
# secret the KP21 plugin must send as the x-api-key header on every
# wp-sync call. WP_BASE_URL/WP_APP_USER/WP_APP_PASSWORD are used by the
# Engine to call back into WP via a WordPress Application Password
# (WP core feature: Users -> Profile -> Application Passwords).
WP_ENGINE_API_KEY=
WP_BASE_URL=
WP_APP_USER=
WP_APP_PASSWORD=
